{
  "name": "league/oauth2-client",
  "description": "OAuth 2.0 Client Library",
  "license": "MIT",
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^8.5.2",
    "guzzlehttp/psr7": "^3.5.1"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.15",
    "php-parallel-lint/php-parallel-lint": "^1.4.0",
    "phpunit/phpunit": "^11.5.58",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "keywords": [
    "oauth",
    "oauth2",
    "authorization",
    "authentication",
    "idp",
    "identity",
    "sso",
    "single sign on"
  ],
  "authors": [
    {
      "name": "Alex Bilbie",
      "email": "hello@alexbilbie.com",
      "homepage": "http://www.alexbilbie.com",
      "role": "Developer"
    },
    {
      "name": "Woody Gilk",
      "homepage": "https://github.com/shadowhand",
      "role": "Contributor"
    },
    {
      "name": "Andrew Millington",
      "homepage": "https://github.com/sephster",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "League\\OAuth2\\Client\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "League\\OAuth2\\Client\\Test\\": "test/src/"
    }
  }
}
