{
    "name": "league/oauth2-client",
    "description": "OAuth 2.0 Client Library",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^7.1 || >=8.0.0 <8.6.0",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.5.8 || ^7.8.2 || ^8.0",
        "guzzlehttp/psr7": "^1.9.1 || ^2.6.3 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.3.5",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^7 || ^8 || ^9 || ^10 || ^11",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "suggest": {
        "symfony/http-client": "A PSR-18 compatible HTTP client, usable with setPsrHttpClient()",
        "kriswallsmith/buzz": "A PSR-18 compatible HTTP client, usable with setPsrHttpClient()",
        "nyholm/psr7": "PSR-7 and PSR-17 implementation, usable to build requests without Guzzle"
    },
    "keywords": [
        "oauth",
        "oauth2",
        "authorization",
        "authentication",
        "idp",
        "identity",
        "sso",
        "single sign on"
    ],
    "authors": [
        {
            "name": "Alex Bilbie",
            "email": "hello@alexbilbie.com",
            "homepage": "http://www.alexbilbie.com",
            "role": "Developer"
        },
        {
            "name": "Woody Gilk",
            "homepage": "https://github.com/shadowhand",
            "role": "Contributor"
        }

    ],
    "autoload": {
        "psr-4": {
            "League\\OAuth2\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "League\\OAuth2\\Client\\Test\\": "test/src/"
        }
    }
}
